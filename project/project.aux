\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Shrinkage of posterior $\hat  \beta _s$: Model 2 (hierarchical) vs.\ Model 1 (independent). All states are shrunk toward the national mean $\mu _\beta = 0.966$, with the largest adjustments for states with the most extreme individual estimates}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:shrinkage}{{1}{5}{Shrinkage of posterior $\hat \beta _s$: Model 2 (hierarchical) vs.\ Model 1 (independent). All states are shrunk toward the national mean $\mu _\beta = 0.966$, with the largest adjustments for states with the most extreme individual estimates}{figure.1}{}}
